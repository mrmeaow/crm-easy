{
  "name": "crm-easy",
  "version": "0.1.0",
  "description": "CRM-Easy — offline-first desktop CRM for individuals (Electron + React + SQLite)",
  "main": "./out/main/index.js",
  "author": "CRM-Easy",
  "license": "MIT",
  "homepage": "https://crmeasy.app",
  "desktopName": "crm-easy",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "npm run typecheck && electron-vite build",
    "build:linux": "npm run build && electron-builder --linux deb rpm --x64 --arm64",
    "build:linux:all": "npm run build && electron-builder --linux deb rpm AppImage pacman --x64 --arm64",
    "build:linux:appimage": "npm run build && electron-builder --linux AppImage --x64 --arm64",
    "build:linux:pacman": "npm run build && electron-builder --linux pacman --x64 --arm64",
    "build:win": "npm run build && electron-builder --win nsis --x64 --arm64",
    "build:win:msi": "npm run build && electron-builder --win msi --x64 --arm64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
